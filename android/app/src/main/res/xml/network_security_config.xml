<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is disabled by default; OkHttp API traffic stays HTTPS-only via
  NetworkModule pinning. WebView integration URLs are admin-configured and may
  point at a self-hosted Directus instance on HTTP until TLS is enabled there.

  When Directus moves to HTTPS, remove or narrow the domain-config below and
  use https:// URLs in Collection integration → WebView.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Coolify sslip.io Directus host (WebView integration mode). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">139.59.31.142.sslip.io</domain>
    </domain-config>

    <debug-overrides cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
