<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: required for our HTTPS API calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 5+ uses GPS. We declare these now so Phase 4 builds remain
         stable when we start gating screens behind them. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Phase 7: background location is requested via the in-app rationale
         screen the first time the agent enables active-duty tracking. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Phase 7: foreground service for the active-duty location tracker.
         POST_NOTIFICATIONS is needed on Android 13+ so the persistent
         notification renders; the system grants it implicitly to apps
         targeting < 33 but we ask explicitly to be safe. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 8: photo capture for collection proof. CAMERA is requested
         in-app the first time the agent opens the capture sheet; the
         camera hardware feature stays optional so devices without one
         still install (the photo step is skippable). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".VctsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vcts.Splash"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vcts.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 6: disable the default WorkManager initializer so Hilt's
             custom Configuration.Provider wins. Without this, WorkManager
             auto-initializes via androidx.startup before Hilt is ready and
             our HiltWorkerFactory is never installed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Phase 7: foreground tracker that captures one GPS fix every
             5 minutes while the agent is on duty. Type "location" is
             required on Android 14+; we keep `exported="false"` since
             only the app starts and stops the service. -->
        <service
            android:name=".tracking.LocationLoggerService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Phase 8: FileProvider used by the share-sheet hand-off so we
             can pass receipt PDFs and captured photos to WhatsApp, Gmail,
             etc., without leaking the app's private storage URIs. The
             authority MUST stay in sync with FileShare.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>
</manifest>
