# ---------------------------------------------------------------------------
# VCTS - Web environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# ---------- Neon Postgres ----------
# Pooled (used at runtime by the Next.js server)
DATABASE_URL=""
# Unpooled (used by migrations and the seed script - direct session, no pgbouncer)
DATABASE_URL_UNPOOLED=""

# Legacy pg environment variables auto-generated by Neon; not required by our code
PGHOST=""
PGHOST_UNPOOLED=""
PGUSER=""
PGDATABASE=""
PGPASSWORD=""

# Vercel-flavoured Postgres aliases; not required by our code
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""
POSTGRES_URL_NO_SSL=""
POSTGRES_PRISMA_URL=""

# ---------- Auth: JWT RS256 ----------
# Run `pnpm keys:generate` once and paste the output here.
# Keys are base64-encoded PEM so they can sit on a single line.
JWT_PRIVATE_KEY_BASE64=""
JWT_PUBLIC_KEY_BASE64=""
JWT_ACCESS_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="30d"

# ---------- Auth: password hashing ----------
# 32-byte random string appended to every password before bcrypt. Rotating this
# invalidates every user's password - treat like a root secret.
PASSWORD_PEPPER=""

# ---------- Audit trail ----------
# Used to HMAC-sign each audit row, chaining into the previous row's HMAC.
# Tamper-evident; rotating it breaks integrity verification for history.
AUDIT_HMAC_SECRET=""

# ---------- App DB role ----------
# Runtime queries use a separate DB role (`vcts_app`) without BYPASSRLS, so
# Postgres enforces tenant isolation even if app code is buggy. This is that
# role's password; `pnpm db:rls` creates or updates the role to match.
APP_DB_PASSWORD=""

# ---------- Google Maps ----------
# Maps JS + Static Maps + Geocoding (restricted to your domains). Server-side
# only; used by /api/geocode proxy.
MAPS_API_KEY=""
# Same key, exposed to the browser for the Maps JavaScript API. HTTP-referrer
# restrictions in GCP keep abuse at bay, so exposing this is expected.
NEXT_PUBLIC_MAPS_API_KEY=""
# Android Maps SDK key (restricted to package + SHA-1). Consumed by the Android
# app; kept here for documentation only.
ANDROID_API_KEY=""

# ---------- Upstash Redis ----------
UPSTASH_REDIS_KV_REST_API_READ_ONLY_TOKEN=""
UPSTASH_REDIS_KV_REST_API_TOKEN=""
UPSTASH_REDIS_KV_REST_API_URL=""
UPSTASH_REDIS_KV_URL=""
UPSTASH_REDIS_REDIS_URL=""

# ---------- Cloudflare R2 (added in Phase 3) ----------
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL=""

# ---------- Cron secret (Phase 7) ----------
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to scheduled jobs.
# Generate with `pnpm keys:generate` (or any 32+ char random string) and set
# the same value in Vercel project settings under "Cron Secret".
CRON_SECRET=""

# ---------- Visit-validation tunables (Phase 7) ----------
# Sustained-presence threshold: how long the agent must remain inside a
# customer's geofence for the cron worker to record a visit.
VISIT_MIN_DWELL_SECONDS="180"
# How far back (minutes) the cron worker scans on each run. Two cron windows
# of overlap is fine - the (agent, customer, started_at) unique index drops
# duplicates.
VISIT_RECOMPUTE_LOOKBACK_MIN="60"
# Cross-correlation tolerance for collections vs. tracker fixes. If a
# collection write has no location_log within this many minutes from the
# matching customer fence, we raise an `unverified_visit` supervisor review.
VISIT_COLLECTION_TOLERANCE_MIN="5"

# ---------- Phase 8: public verification base URL ----------
# Origin embedded in QR codes and the share-sheet text. Should be the
# production domain (e.g. https://vcts.example.com); leave blank in dev
# and the verify links will fall back to relative `/r/...` URLs.
PUBLIC_BASE_URL=""
NEXT_PUBLIC_PUBLIC_BASE_URL=""

# ---------- Phase 10: rate-limit budgets (per minute) ----------
# Existing `COLLECTIONS_RATE_PER_MIN` (default 10) caps direct collection
# writes per (tenant, agent). The buckets below cover the rest of the
# attack surface; defaults are deliberately generous to avoid annoying
# real users while still throttling obvious misuse.
COLLECTIONS_RATE_PER_MIN="10"
LOGIN_IP_RATE_PER_MIN="20"
LOGIN_EMAIL_RATE_PER_MIN="5"
ATTACHMENT_RATE_PER_MIN="60"
SYNC_PUSH_RATE_PER_MIN="60"
LOCATION_LOG_RATE_PER_MIN="60"
GEOCODE_RATE_PER_MIN="60"
TENANT_BRANDING_RATE_PER_MIN="10"

# ---------- Directus CMS (Collection Integration) ----------
# These three are read by the Next.js server (Vercel / .env.local). The
# Coolify-managed Directus service has its own env block (see below).
#
# Public base URL of your Directus instance (no :8055 — Coolify proxies :80).
# Coolify: SERVICE_URL_DIRECTUS
DIRECTUS_URL=""
#
# Create in Directus admin → Settings → Access Tokens (admin role). Server-side
# only; used to provision tenant collections via the schema API.
DIRECTUS_ADMIN_TOKEN=""
#
# Per-tenant static tokens (Directus role scoped to `t_<slug>__*` collections).
# JSON object: tenant slug → token string.
DIRECTUS_TENANT_TOKENS="{}"
#
# Set this on BOTH sides: your Vercel app origin here, and the same value as
# CORS_ORIGIN in Coolify Directus env (e.g. https://your-app.vercel.app).
DIRECTUS_CORS_ORIGIN=""

# ---------- Coolify Directus service (configure in Coolify, NOT .env.local) --
# Reference mapping from a Coolify one-click Directus deploy. Values live in
# the Coolify resource environment tab; do not copy secrets into git.
#
# SERVICE_URL_DIRECTUS=http://directus-<id>.<ip>.sslip.io
# SERVICE_FQDN_DIRECTUS=directus-<id>.<ip>.sslip.io
# SERVICE_URL_DIRECTUS_8055=...:8055   # internal; do not use in browsers
# KEY=$SERVICE_BASE64_64_KEY
# SECRET=$SERVICE_BASE64_64_SECRET
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=$SERVICE_PASSWORD_ADMIN
# POSTGRESQL_DATABASE=directus
# DB_USER=$SERVICE_USER_POSTGRESQL
# DB_PASSWORD=$SERVICE_PASSWORD_POSTGRESQL
# POSTGRES_USER=${SERVICE_USER_POSTGRESQL}
# POSTGRES_PASSWORD=${SERVICE_PASSWORD_POSTGRESQL}
# CORS_ENABLED=true
# CORS_ORIGIN=<same as DIRECTUS_CORS_ORIGIN / your Vercel app URL>
# CORS_METHODS=GET,POST,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Content-Type,Authorization
# CORS_CREDENTIALS=true
# PUBLIC_URL=<same as SERVICE_URL_DIRECTUS, no port>
